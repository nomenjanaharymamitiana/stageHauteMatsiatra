# Base de donnees PostgreSQL (notation reprise du backend DAG/RH : port 5432, base ged_db)
DATABASE_URL=postgresql+psycopg2://postgres:RsiPostgres2026@localhost:5432/ged_db

# Securite JWT (ajout necessaire : le backend DAG d'origine n'emettait pas de jeton)
SECRET_KEY=change-moi-en-production-avec-une-vraie-cle-secrete
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Aide IA au remplissage (optionnel) : laisser vide pour desactiver le bouton "Aide IA"
# Cle a obtenir sur https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
